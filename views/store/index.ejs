<%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>
    
        
    <main class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-xl">
        <h2 class="p-4 mx-2 my-3 rounded-md text-red-400 text-3xl font-bold text-center">Welcome to airbnb index page</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% registeredHomes.forEach(home =>{ %>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow duration-300">
                <div class="h-36 md:h-48 bg-gray-300 flex items-center justify-center">

                        <img src="<%= home.photo %>" 
                             alt="<%= home.houseName %>" 
                             class="w-full h-full object-cover">
                    
                </div>
                <div class="p-4 md:p-6">
                    <h3 class="text-lg md:text-xl font-bold text-gray-800 mb-1 md:mb-2"><%= home.houseName %></h3>
                    <div class="flex items-center mb-2 md:mb-3">
                        <span class="text-yellow-500 text-lg">★</span>
                        <span class="ml-1 text-gray-600 font-medium"><%= home.rating %>/5</span>
                    </div>
                    <p class="text-gray-600 mb-1 md:mb-2 text-sm md:text-base">📍 <%= home.location %></p>
                    <div class="mt-2 md:mt-4 pt-3 md:pt-4 border-t border-gray-200">
                        <span class="text-xl md:text-2xl font-bold text-green-600">Rs<%= home.price %></span>
                        <span class="text-gray-500 text-sm">/night</span>
                    </div>
                    <button class="mt-3 md:mt-4 w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200">
                        Book Now
                    </button>
                </div>
            </div>
            <% }); %>
        </div>
    </main>
</body>
</html>