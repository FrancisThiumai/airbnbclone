<%- include('../partials/head') %>
    </head>

    <body class="bg-gradient-to-br from-red-50 via-white to-orange-50 min-h-screen">
        <%- include('../partials/nav') %>
            <main class="container mx-auto px-4 py-10">
                <div class="max-w-xl mx-auto bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r from-red-500 to-red-600 px-8 py-6 text-white">
                        <h1 class="text-3xl font-bold text-center">Create your account</h1>
                        <p class="text-center mt-2 text-red-100">Join Airbnb and start hosting or booking today</p>
                    </div>

                    <form action="/sign-up" method="POST" class="px-8 py-8 space-y-5">
                        <%- include('../partials/error') %>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                                        <input type="text" name="firstName" placeholder="First Name"
                                            value="<%=oldInput.firstName ? oldInput.firstName : ''%>"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                                            required />
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                                        <input type="text" name="lastName" placeholder="Last Name"
                                            value="<%=oldInput.lastName ? oldInput.lastName : ''%>"
                                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                                            required />
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                                    <input type="email" name="email" placeholder="you@example.com" required
                                        value="<%=oldInput.email ? oldInput.email : ''%>"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition" />
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                                    <input type="password" name="password" placeholder="Enter your password"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                                        title="minimum 8 characters with 1 lower, upper case, number, special character">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
                                    <input type="password" name="confirmPassword" placeholder="Confirm your password"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                                        title="minimum 8 characters with 1 lower, upper case, number, special character">
                                </div>

                                <div class="pt-2">
                                    <p class="text-sm font-medium text-gray-700 mb-3">User type</p>
                                    <div class="grid grid-cols-2 gap-3">
                                        <label
                                            class="flex items-center gap-2 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-red-300 transition">
                                            <input type="radio" name="userType" value="host" id="host"
                                                <%= oldInput.userType === 'host' ? 'checked' : '' %>
                                                class="text-red-500"/>
                                            <span class="font-medium text-gray-700">Host</span>
                                        </label>

                                        <label
                                            class="flex items-center gap-2 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer hover:border-red-300 transition">
                                            <input type="radio" name="userType" value="guest" id="guest"
                                                <%= (!oldInput.userType || oldInput.userType === 'guest') ? 'checked' : '' %>
                                                class="text-red-500" />
                                            <span class="font-medium text-gray-700">Guest</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="pt-2">
                                    <label class="flex items-start gap-3 text-sm text-gray-600">
                                        <input type="checkbox" name="terms" id="terms" required
                                            class="mt-1 text-red-500 rounded" />
                                        <span>I agree to the terms and conditions</span>
                                    </label>
                                </div>

                                <button type="submit"
                                    class="w-full mt-4 bg-gradient-to-r from-red-500 to-red-600 text-white font-semibold py-3 px-4 rounded-xl shadow-md hover:shadow-lg hover:from-blue-500 hover:to-yellow-700 transition duration-300">
                                    Create Account
                                </button>
                    </form>
                </div>
            </main>
    </body>

    </html>