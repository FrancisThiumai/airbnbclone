<%- include('../partials/head')%>
</head>
<body>
    <%- include('../partials/nav')%>
    <main class="container mx-auto p-8 rounded-lg shadow-md">
        <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">
            Login
        </h1>
        <form action="/login" method="POST" class="max-w-md mx-auto">
            <%- include('../partials/error') %>
            
            <div class="relative mb-4 flex items-center">
                <i class="bi bi-envelope absolute left-3 text-gray-400"></i>
                <input type="text" name="email" placeholder="enter email address" 
                value="<%=oldInput.email? oldInput.email : '' %>"
                class="w-full pl-10 pr-4 py-2 border rounded-md 
                focus:outline-none focus:ring-2 focus:ring-red-500"
                required/>
            </div>

            <div class="relative mb-4 flex items-center">
                <i class="bi bi-lock absolute left-3 text-gray-400"></i>
                <input type="password" name="password" placeholder="Enter your password" 
                class="w-full pl-10 pr-4 py-2 border rounded-md 
                focus:outline-none focus:ring-2 focus:ring-red-500"
                title="minimum 8 characters with 1 lower, upper case, number, special character"
                pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[\W_]).{8,}"
                />
            </div>

            <input type="submit" value="Sign In"
            class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300"/>
        </form>
    </main>
</body>
</html>